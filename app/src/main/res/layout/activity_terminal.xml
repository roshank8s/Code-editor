<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/terminal_bg">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:title="@string/terminal"
        app:titleTextColor="@color/terminal_fg"
        app:navigationIcon="@android:drawable/ic_menu_close_clear_cancel" />

    <!-- Terminal output -->
    <ScrollView
        android:id="@+id/terminalScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/terminalOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:textColor="@color/terminal_fg"
            android:padding="8dp"
            android:gravity="bottom"
            android:textIsSelectable="true" />

    </ScrollView>

    <!-- Input area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface_dark">

        <!-- Extra keys -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyEsc"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="ESC"
                    android:textSize="10sp"
                    android:minWidth="40dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyTab"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="TAB"
                    android:textSize="10sp"
                    android:minWidth="40dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyCtrl"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="CTRL"
                    android:textSize="10sp"
                    android:minWidth="40dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyAlt"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="ALT"
                    android:textSize="10sp"
                    android:minWidth="40dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyPipe"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="|"
                    android:textSize="12sp"
                    android:minWidth="36dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keySlash"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="/"
                    android:textSize="12sp"
                    android:minWidth="36dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDash"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="-"
                    android:textSize="12sp"
                    android:minWidth="36dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyUp"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="\u2191"
                    android:textSize="13sp"
                    android:minWidth="36dp"
                    style="@style/Widget.Material3.Button.TextButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDown"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="\u2193"
                    android:textSize="13sp"
                    android:minWidth="36dp"
                    style="@style/Widget.Material3.Button.TextButton" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- Command input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <EditText
                android:id="@+id/terminalInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textColor="@color/terminal_fg"
                android:backgroundTint="@color/terminal_fg"
                android:hint="$"
                app:hintTextColor="#666666"
                android:inputType="text"
                android:imeOptions="actionSend"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_send"
                android:contentDescription="Send"
                android:scaleType="centerInside" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
