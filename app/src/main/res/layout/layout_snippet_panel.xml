<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/snippet_bg"
    android:padding="12dp"
    android:maxHeight="400dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/snippets"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Category tabs -->
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/categoryChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:singleSelection="true"
        app:selectionRequired="true"
        android:layout_marginBottom="8dp">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipGit"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/git_commands"
            android:textSize="11sp"
            android:checked="true" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFiles"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_operations"
            android:textSize="11sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipDev"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dev_tools"
            android:textSize="11sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipSystem"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/system_commands"
            android:textSize="11sp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipCustom"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/custom_snippets"
            android:textSize="11sp" />

    </com.google.android.material.chip.ChipGroup>

    <!-- Snippet list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/snippetList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="250dp"
        android:nestedScrollingEnabled="true" />

    <!-- Add custom snippet button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAddSnippet"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="@string/add_snippet"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
