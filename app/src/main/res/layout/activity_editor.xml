<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Compact Status bar -->
        <LinearLayout
            android:id="@+id/statusBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/status_bar_height"
            android:background="@color/primary_dark"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:orientation="horizontal">

            <View
                android:id="@+id/statusDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@color/status_connecting" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/connecting"
                android:textColor="@android:color/white"
                android:textSize="@dimen/status_bar_text_size"
                android:layout_marginStart="6dp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageButton
                android:id="@+id/btnToggleKeyboard"
                android:layout_width="@dimen/status_bar_icon_size"
                android:layout_height="@dimen/status_bar_icon_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_keyboard_24"
                android:contentDescription="@string/toggle_keyboard"
                android:scaleType="centerInside"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="@dimen/status_bar_icon_size"
                android:layout_height="@dimen/status_bar_icon_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_fullscreen_24"
                android:contentDescription="@string/enter_fullscreen"
                android:scaleType="centerInside"
                android:layout_marginEnd="4dp" />

            <ImageButton
                android:id="@+id/btnDisconnect"
                android:layout_width="@dimen/status_bar_icon_size"
                android:layout_height="@dimen/status_bar_icon_size"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="@string/disconnect"
                android:scaleType="centerInside" />

        </LinearLayout>

        <!-- Reconnect banner -->
        <TextView
            android:id="@+id/reconnectBanner"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:background="@color/reconnect_banner"
            android:gravity="center"
            android:text="@string/reconnecting"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- WebView for code-server -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Loading overlay -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:visibility="visible"
        android:elevation="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                style="?android:attr/progressBarStyle" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connecting"
                android:textColor="@color/on_surface_dark"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Floating keyboard container -->
    <FrameLayout
        android:id="@+id/floatingKeyboardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="12dp" />

    <!-- FAB Speed Dial -->
    <!-- Mini FABs (hidden by default) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabSnippets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="200dp"
        app:srcCompat="@drawable/ic_code_24"
        app:fabSize="mini"
        app:backgroundTint="@color/fab_secondary"
        android:contentDescription="@string/fab_snippets"
        android:visibility="gone"
        app:tint="@android:color/white"
        android:elevation="14dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFullscreen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="152dp"
        app:srcCompat="@drawable/ic_fullscreen_24"
        app:fabSize="mini"
        app:backgroundTint="@color/fab_secondary"
        android:contentDescription="@string/fab_fullscreen"
        android:visibility="gone"
        app:tint="@android:color/white"
        android:elevation="14dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabKeyboard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="104dp"
        app:srcCompat="@drawable/ic_keyboard_24"
        app:fabSize="mini"
        app:backgroundTint="@color/fab_secondary"
        android:contentDescription="@string/fab_keyboard"
        android:visibility="gone"
        app:tint="@android:color/white"
        android:elevation="14dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabBrowser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="56dp"
        app:srcCompat="@drawable/ic_public_24"
        app:fabSize="mini"
        app:backgroundTint="@color/fab_secondary"
        android:contentDescription="@string/fab_browser"
        android:visibility="gone"
        app:tint="@android:color/white"
        android:elevation="14dp" />

    <!-- Main FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/fab_margin"
        app:srcCompat="@drawable/ic_add_24"
        app:backgroundTint="@color/fab_primary"
        app:tint="@android:color/white"
        android:elevation="14dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
