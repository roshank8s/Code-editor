<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/browser_bg">

    <!-- Address bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/browser_address_height"
        android:orientation="horizontal"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="localhost:"
            android:textColor="@color/on_surface_dark"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/portInput"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:background="@color/background_dark"
            android:hint="@string/enter_port"
            android:textColor="@android:color/white"
            android:textColorHint="#666666"
            android:textSize="13sp"
            android:inputType="number"
            android:maxLength="5"
            android:paddingHorizontal="8dp"
            android:gravity="center"
            android:singleLine="true"
            android:imeOptions="actionGo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGo"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="@string/go"
            android:textSize="12sp"
            android:layout_marginStart="4dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnCloseBrowser"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="@string/close"
            android:scaleType="centerInside" />

    </LinearLayout>

    <!-- Recent ports chips -->
    <HorizontalScrollView
        android:id="@+id/recentPortsContainer"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/surface_dark"
        android:scrollbars="none"
        android:visibility="gone">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/recentPortsChips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            app:singleLine="true" />

    </HorizontalScrollView>

    <!-- Navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/browser_nav_height"
        android:orientation="horizontal"
        android:background="@color/surface_dark"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="@string/browser_back"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="@string/browser_forward"
            android:scaleType="centerInside" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="@string/browser_refresh"
            android:scaleType="centerInside" />

        <TextView
            android:id="@+id/browserUrl"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#999999"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:layout_marginHorizontal="8dp" />

    </LinearLayout>

    <!-- Browser WebView -->
    <WebView
        android:id="@+id/browserWebView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
