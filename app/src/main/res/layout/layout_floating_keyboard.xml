<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Collapsed pill view -->
    <TextView
        android:id="@+id/collapsedPill"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_floating_keyboard"
        android:text="@string/keyboard_collapsed"
        android:textColor="@color/on_surface_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Expanded keyboard panel -->
    <LinearLayout
        android:id="@+id/expandedPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_keyboard"
        android:elevation="8dp">

        <!-- Drag handle -->
        <FrameLayout
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_drag_handle_height"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/ic_drag_handle_24"
                android:scaleType="centerInside"
                android:contentDescription="Drag to move" />

            <!-- Opacity slider (shown on long-press of drag handle) -->
            <SeekBar
                android:id="@+id/opacitySlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:min="30"
                android:max="100"
                android:progress="100"
                android:visibility="gone"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />
        </FrameLayout>

        <!-- Full keyboard rows (populated programmatically) -->
        <LinearLayout
            android:id="@+id/keyboardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="2dp"
            android:paddingBottom="2dp" />

    </LinearLayout>

</merge>
