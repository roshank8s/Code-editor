<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed pill view -->
    <TextView
        android:id="@+id/collapsedPill"
        android:layout_width="48dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_floating_keyboard"
        android:text="@string/keyboard_collapsed"
        android:textColor="@color/on_surface_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Expanded keyboard panel -->
    <LinearLayout
        android:id="@+id/expandedPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_floating_keyboard"
        android:elevation="8dp">

        <!-- Drag handle -->
        <FrameLayout
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_drag_handle_height"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/ic_drag_handle_24"
                android:scaleType="centerInside"
                android:contentDescription="Drag to move" />

            <!-- Opacity slider (shown on long-press) -->
            <SeekBar
                android:id="@+id/opacitySlider"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:min="30"
                android:max="100"
                android:progress="100"
                android:visibility="gone"
                android:progressTint="@color/primary"
                android:thumbTint="@color/primary" />
        </FrameLayout>

        <!-- Row 1: Modifiers + Characters -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_row_height"
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal">

            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyEsc"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="ESC"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyTab"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="TAB"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyCtrl"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="CTRL"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyAlt"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="ALT"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyShift"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="SHIFT"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyPipe"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="|"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keySlash"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="/"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDash"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="-"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyTilde"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="~"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyUnderscore"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="_"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyColon"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text=":"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keySemicolon"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text=";"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyBraceOpen"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="{"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyBraceClose"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="}"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyBracketOpen"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="["
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyBracketClose"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="]"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyQuote"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="&apos;"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDoubleQuote"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="&quot;"
                    android:textSize="@dimen/kb_symbol_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyBackslash"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="\\"
                    android:textSize="@dimen/kb_symbol_text_size" />

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Row 2: Quick Shortcuts + Navigation -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/kb_row_height"
            android:scrollbars="none"
            android:fadingEdge="horizontal"
            android:fadingEdgeLength="16dp"
            android:requiresFadingEdge="horizontal">

            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keySave"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="SAVE"
                    android:textSize="@dimen/kb_button_text_size"
                    android:textColor="@color/primary_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyUndo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="UNDO"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyRedo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="REDO"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyCmd"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="CMD"
                    android:textSize="@dimen/kb_button_text_size"
                    android:textColor="@color/primary_light" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyFind"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="FIND"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyClose"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="CLOSE"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyHome"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="HOME"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyEnd"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="END"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyPgUp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="PGUP"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyPgDn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="PGDN"
                    android:textSize="@dimen/kb_button_text_size" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyLeft"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="\u2190"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyRight"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="\u2192"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyUp"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="\u2191"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDown"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="32dp"
                    android:text="\u2193"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/keyDel"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/kb_button_height"
                    android:minWidth="@dimen/kb_button_min_width"
                    android:text="DEL"
                    android:textSize="@dimen/kb_button_text_size" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

</FrameLayout>
